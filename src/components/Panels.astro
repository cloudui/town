---
// Renders each panel from src/content/site.js into a <template>.
// panels.js clones the right one into the card when a place is opened.
import { panels, directory } from "../content/site.js";
import books from "../content/books.json";
import PixelLogo from "./PixelLogo.astro";

const ext = { target: "_blank", rel: "noopener" };
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const photo = (file: string, thumb = false) => `${base}photos/${file}${thumb ? "-thumb" : ""}.webp`;
---
{Object.entries(panels).map(([id, p]) => (
  <template id={`t-${id}`} data-wide={p.wide ? "" : undefined}>
    <h2 id="panel-title">{p.title}</h2>
    {p.body?.map((text, i) => <p class={p.lede && i === 0 ? "lede" : undefined}>{text}</p>)}
    {p.photos && (
      <>
        <ul class="prints" data-prints>
          {p.photos.map((ph, i) => (
            <li>
              <button
                type="button"
                class="print"
                data-photo={i}
                data-full={photo(ph.file)}
                data-caption={ph.caption}
                data-note={ph.note}
                aria-label={`Open photo: ${ph.caption}`}
              >
                <img src={photo(ph.file, true)} alt={ph.alt} width="480" height="360" loading="lazy" decoding="async" />
                <span class="cap" aria-hidden="true">{ph.caption}</span>
              </button>
            </li>
          ))}
        </ul>
        <div class="viewer" data-viewer hidden>
          <figure class="print big">
            <img alt="" width="900" height="675" />
            <figcaption class="cap"></figcaption>
          </figure>
          <p class="note"></p>
          <div class="viewer-nav">
            <button class="pbtn" type="button" data-step="-1" aria-label="Previous photo">←</button>
            <span class="count" aria-live="polite"></span>
            <button class="pbtn" type="button" data-step="1" aria-label="Next photo">→</button>
            <button class="pbtn back" type="button" data-back>All photos</button>
          </div>
        </div>
      </>
    )}
    {p.jobs && (
      <section class="jobs-wrap" data-picker>
        {p.jobsTitle && <h3 class="sec">{p.jobsTitle}</h3>}
        <ul class="jobs">
          {p.jobs.map((j, i) => (
            <li>
              <button type="button" class:list={["sign", { on: i === 0 }]} data-pick aria-pressed={i === 0 ? "true" : "false"}>
                {/* string from the top corners up to a pushpin */}
                <svg class="hang" viewBox="0 0 100 20" preserveAspectRatio="none" aria-hidden="true">
                  <path d="M1 20 L50 3 L99 20" fill="none" stroke="currentColor" stroke-width="2" vector-effect="non-scaling-stroke" />
                </svg>
                <span class="pin" aria-hidden="true"></span>
                <span class="logo"><PixelLogo name={j.logo} label={`${j.name} logo`} /></span>
                <span class="name">{j.name}</span>
                <span class="role">{j.role}</span>
              </button>
            </li>
          ))}
        </ul>
        <div class="blurbs">
          {p.jobs.map((j, i) => (
            <div class:list={["blurb", { on: i === 0 }]} data-blurb>
              <h3>{j.title || j.role}, {j.name}</h3>
              {(j.when || j.where) && <p class="date">{[j.when, j.where].filter(Boolean).join(" · ")}</p>}
              {j.text && <p>{j.text}</p>}
              {j.points && <ul class="points">{j.points.map((t) => <li>{t}</li>)}</ul>}
              {j.link && <a href={j.link.href} {...ext}>{j.link.label}</a>}
            </div>
          ))}
        </div>
      </section>
    )}
    {p.shelf && books.length > 0 && (
      <div class="shelf-wrap" data-picker>
        <ul class="shelf">
          {books.map((b, i) => (
            <li>
              <a
                class:list={["book", { on: i === 0 }]}
                href={b.href}
                {...ext}
                data-pick
                aria-label={[b.title, b.desc].filter(Boolean).join(": ")}
              >
                <span aria-hidden="true">{b.title}</span>
              </a>
            </li>
          ))}
        </ul>
        {/* Every blurb is stacked in one grid cell and only the picked one is visible,
            so the box is always as tall as the longest and never jumps. */}
        <div class="blurbs">
          {books.map((b, i) => (
            <div class:list={["blurb", { on: i === 0 }]} data-blurb>
              <h3>{b.title}</h3>
              {b.date && <p class="date">{b.date}</p>}
              <p>{b.desc}</p>
              <a href={b.href} {...ext}>Read it →</a>
            </div>
          ))}
        </div>
      </div>
    )}
    {p.items && p.itemsTitle && <h3 class="sec">{p.itemsTitle}</h3>}
    {p.items && (
      <ul class="list">
        {p.items.map((it) => (
          <li>
            <div class="head"><h3>{it.title}</h3>{it.chip && <span class="chip">{it.chip}</span>}</div>
            <p>{it.text}</p>
            {it.link && <a href={it.link.href} {...ext}>{it.link.label}</a>}
          </li>
        ))}
      </ul>
    )}
    {p.email && (
      <>
        <div class="mailrow">
          <code id="email">{p.email}</code>
          <button class="pbtn" type="button" data-copy="email">Copy</button>
        </div>
        <p class="muted" data-copied hidden aria-live="polite">Copied to your clipboard.</p>
      </>
    )}
    {p.link && <a href={p.link.href} {...ext}>{p.link.label}</a>}
  </template>
))}

<template id="t-directory">
  <h2 id="panel-title">{directory.title}</h2>
  <ul class="dir">
    {directory.places.map((d) => (
      <li><button type="button" data-open={d.panel}>{d.name}</button><span>{d.note}</span></li>
    ))}
    {directory.links.map((l) => (
      <li><a href={l.href} {...ext}>{l.label}</a><span>{l.handle}</span></li>
    ))}
  </ul>
</template>
